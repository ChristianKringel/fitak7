# 32-byte key, base64-encoded, used to encrypt infinite-mode round tokens (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ROUND_SECRET=

# Upstash Redis REST credentials, used by the multiplayer rooms. Created by the
# Vercel Marketplace integration; locally, copy them from the Vercel or Upstash dashboard.
KV_REST_API_URL=
KV_REST_API_TOKEN=
